<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Generic_T2_Slavery</defName>
    <settlementSize>50,50</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    
    <centerBuildings>
      <centralBuildingTags>
        <li>Generic_Prison</li>
      </centralBuildingTags>
      <allowedStructures>
        <li>
          <tag>Generic_Throne</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>Generic_Bedroom</tag>
          <count>1~2</count>
        </li>
		<li>
          <tag>Generic_Luxury_Bedroom</tag>
          <count>0~1</count>
        </li>

		<li>
          <count>0~1</count>
          <tag>TSA_Tribal_Recreation</tag>
        </li>
      </allowedStructures>
    </centerBuildings>

    <peripheralBuildings>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_Barricade</tag>
          <count>3~8</count>
        </li>
      </allowedStructures>
    </peripheralBuildings>

	<defenseOptions>
		<addEdgeDefense>true</addEdgeDefense>
		<addSandbags>true</addSandbags>
		<addTurrets>false</addTurrets>
		<pawnGroupMultiplier>0.75</pawnGroupMultiplier>
	</defenseOptions>

    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>5</scatterMinDistance>
      <scatterMaxAmount>12</scatterMaxAmount>
      <scatterPropsDefs>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_BoxSmall</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_WoodenLogsLarge</li>
		<li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_WoodenWagon</li>
		<li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_FilthDirt</li>
		<li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_WoodenChest</li>
      </scatterPropsDefs>
    </propsOptions>

    <stockpileOptions>
      <stockpileValueMultiplier>0.5</stockpileValueMultiplier>
      <fillStorageBuildings>true</fillStorageBuildings>
      <fillWithDefs>
        <li>MedicineHerbal</li>
        <li>WoodLog</li>
        <li>Jade</li>
		<li>Cloth</li>
      </fillWithDefs>
    </stockpileOptions>
  </KCSG.SettlementLayoutDef>
</Defs>