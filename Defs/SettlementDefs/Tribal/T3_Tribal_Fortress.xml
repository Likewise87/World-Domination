<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Tribal_T3_Fortress</defName>
	<settlementSize>90,90</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    <centerBuildings Inherit="False">
	  <centralBuildingTags>
        <li>TSA_Tribal_BigBarracks</li>
      </centralBuildingTags>
      <centerSize>80,80</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <count>1~3</count>
          <tag>TSA_Tribal_Production</tag>
        </li>
		<li>
          <count>1~3</count>
          <tag>TSA_Tribal_Stockpile</tag>
        </li>
        <li>
          <count>0~2</count>
          <tag>TSA_Tribal_Slavery</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>TSA_Tribal_Mining</tag>
        </li>
        <li>
          <count>1~1</count>
          <tag>TSA_Tribal_Recreation</tag>
        </li>
        <li>
          <count>1~3</count>
          <tag>TSA_Tribal_Defence</tag>
        </li>
		<li>
          <count>1~2</count>
          <tag>TSA_Tribal_BigBarracks</tag>
        </li>
		<li>
          <count>1~4</count>
          <tag>TSA_Tribal_Barracks</tag>
        </li>
      </allowedStructures>
    </centerBuildings>
	    <peripheralBuildings>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_Barricade</tag>
          <count>16~30</count>
        </li>
		<li>
          <tag>TSA_Tribal_Farm</tag>
          <count>2~6</count>
        </li>
      </allowedStructures>
    </peripheralBuildings>
    <defenseOptions>
      <pawnGroupMultiplier>1.6</pawnGroupMultiplier>
    </defenseOptions>
    <stockpileOptions>
      <fillStorageBuildings>true</fillStorageBuildings>
      <fillWithDefs>
        <li>Jade</li>
        <li>ComponentIndustrial</li>
        <li>Steel</li>
        <li>Chocolate</li>
        <li>ThrumboHorn</li>
        <li>ElephantTusk</li>
      </fillWithDefs>
    </stockpileOptions>
  </KCSG.SettlementLayoutDef>
 </Defs>