<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- RimWorld 1.7 / Waylith. Frozen 1.6 DLL lives under 1.6/Assemblies. -->
		<TargetFramework>net10.0</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<RimWorldDir>C:\Steam\steamapps\common\RimWorld</RimWorldDir>
	</PropertyGroup>
	<ItemGroup>
	  <None Include="RaidLogic\Reinforcements_Physical.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.3.6" />
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Waylith redirects UnityEngine* → UnityStubs. -->
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="KCSG">
		  <HintPath>..\..\..\..\..\workshop\content\294100\2023507013\1.7\Assemblies\KCSG.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Outposts">
		  <HintPath>..\..\..\..\..\workshop\content\294100\2023507013\1.7\Assemblies\Outposts.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
